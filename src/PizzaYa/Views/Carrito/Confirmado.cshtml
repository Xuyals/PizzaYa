@model PedidoConfirmadoViewModel
@using PizzaYa.Models
@{
    ViewData["Title"] = "Pedido confirmado";
    var co = new System.Globalization.CultureInfo("es-CO");
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        @* ── Encabezado de éxito ── *@
        <div class="text-center mb-4">
            <div class="display-1 mb-2">🎉</div>
            <h1 class="h2 fw-bold text-success">¡Pedido confirmado!</h1>
            <p class="text-muted">Gracias por tu compra, @Model.Nombre.</p>
        </div>

        @* ── Tarjeta de número de pedido ── *@
        <div class="card bg-danger text-white shadow mb-4">
            <div class="card-body text-center py-4">
                <p class="mb-1 fs-5 opacity-75">Número de pedido</p>
                <p class="display-5 fw-bold mb-0 font-monospace">@Model.NumeroPedido</p>
                <p class="small opacity-75 mt-2">@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>

        @* ── Datos del cliente y entrega ── *@
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold">📋 Datos del pedido</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-4">Nombre</dt>
                    <dd class="col-8">@Model.Nombre</dd>

                    <dt class="col-4">Teléfono</dt>
                    <dd class="col-8">@Model.Telefono</dd>

                    <dt class="col-4">Entrega</dt>
                    <dd class="col-8">
                        @if (Model.EsDomicilio)
                        {
                            <span class="badge bg-info text-dark">🛵 Domicilio</span>
                            <span class="ms-2">@Model.Direccion</span>
                        }
                        else
                        {
                            <span class="badge bg-success">🏪 Recoger en tienda</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @* ── Resumen de pizzas ── *@
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold">🍕 Pizzas pedidas</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Pizza</th>
                            <th>Tamaño</th>
                            <th>Borde</th>
                            <th>Extras</th>
                            <th class="text-center">Cant.</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@item.NombrePizza</td>
                                <td>@item.NombreTamano</td>
                                <td>@item.NombreBorde</td>
                                <td>@(item.NombresExtras.Any() ? string.Join(", ", item.NombresExtras) : "—")</td>
                                <td class="text-center">@item.Cantidad</td>
                                <td class="text-end">@item.Subtotal.ToString("C0", co)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* ── Resumen financiero ── *@
        <div class="card shadow-sm mb-4">
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr>
                            <td>Subtotal</td>
                            <td class="text-end">@Model.Subtotal.ToString("C0", co)</td>
                        </tr>
                        @if (Model.CostoDomicilio > 0)
                        {
                            <tr>
                                <td>🛵 Domicilio</td>
                                <td class="text-end">@Model.CostoDomicilio.ToString("C0", co)</td>
                            </tr>
                        }
                        @if (Model.Descuento > 0)
                        {
                            <tr class="text-success">
                                <td>🏷️ Descuento</td>
                                <td class="text-end">- @Model.Descuento.ToString("C0", co)</td>
                            </tr>
                        }
                        <tr class="fw-bold fs-5 table-dark">
                            <td>TOTAL PAGADO</td>
                            <td class="text-end text-warning">@Model.Total.ToString("C0", co)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="text-center">
            <a class="btn btn-outline-danger btn-lg px-4 me-2" asp-controller="Pedidos" asp-action="Seguimiento" asp-route-numero="@Model.NumeroPedido">
                Ver el estado de mi pedido
            </a>
            <a class="btn btn-danger btn-lg px-5" asp-controller="Menu" asp-action="Index">
                🍕 Hacer otro pedido
            </a>
        </div>

    </div>
</div>

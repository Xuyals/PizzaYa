@model ConfirmarPedidoViewModel
@using PizzaYa.Models
@{
    ViewData["Title"] = "Confirmar pedido";
    var co = new System.Globalization.CultureInfo("es-CO");
}

<h1 class="h3 fw-bold mb-4">📋 Confirmar pedido</h1>

@if (TempData["Exito"] is string exitoTemp)
{
    <div class="alert alert-success" role="alert">@exitoTemp</div>
}
@if (TempData["Error"] is string errorTemp)
{
    <div class="alert alert-danger" role="alert">@errorTemp</div>
}

<div class="row g-4">

    @* ── Formulario de datos ── *@
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Datos de contacto y entrega</div>
            <div class="card-body">
                <form asp-controller="Carrito" asp-action="Confirmar" method="post" id="form-confirmar" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold">Nombre *</label>
                        <input asp-for="Nombre" class="form-control" id="input-nombre"
                               placeholder="Tu nombre completo" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefono" class="form-label fw-semibold">Teléfono *</label>
                        <input asp-for="Telefono" class="form-control" id="input-telefono"
                               placeholder="Ej: 3001234567" />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>

                    @* Tipo de entrega *@
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de entrega *</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="EsDomicilio"
                                       id="rb-tienda" value="false"
                                       onchange="toggleDireccion(this.value)">
                                <label class="form-check-label" for="rb-tienda">
                                    🏪 Recoger en tienda <span class="badge bg-success">Gratis</span>
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="EsDomicilio"
                                       id="rb-domicilio" value="true"
                                       onchange="toggleDireccion(this.value)">
                                <label class="form-check-label" for="rb-domicilio">
                                    🛵 Domicilio <span class="badge bg-info text-dark">+ @Model.ValorDomicilio.ToString("C0", co)</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3" id="bloque-direccion" style="display:none">
                        <label asp-for="Direccion" class="form-label fw-semibold">Dirección *</label>
                        <input asp-for="Direccion" class="form-control" id="input-direccion"
                               placeholder="Ej: Cra 5 # 12-34, Apto 201" />
                        <span asp-validation-for="Direccion" class="text-danger small"></span>
                    </div>

                    @* Cupón (opcional) *@
                    <div class="mb-3">
                        <label asp-for="CodigoCupon" class="form-label fw-semibold">Cupón (opcional)</label>
                        <input asp-for="CodigoCupon" class="form-control" id="input-cupon"
                               placeholder="Ej: PIZZA10" />
                        <span asp-validation-for="CodigoCupon" class="text-danger small fw-semibold" id="error-cupon"></span>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-danger btn-lg fw-bold" id="btn-confirmar">
                            ✅ Confirmar pedido
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ── Resumen del carrito ── *@
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">🛒 Tu pedido (@Model.Carrito.Items.Count ítem@(Model.Carrito.Items.Count == 1 ? "" : "s"))</div>
            <ul class="list-group list-group-flush">
                @foreach (var item in Model.Carrito.Items)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <div>
                            <div class="fw-semibold">@item.NombrePizza</div>
                            <small class="text-muted">@item.NombreTamano · @item.NombreBorde · ×@item.Cantidad</small>
                        </div>
                        <span class="fw-bold">@item.Subtotal.ToString("C0", co)</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between">
                    <span>Subtotal</span>
                    <span>@Model.Subtotal.ToString("C0", co)</span>
                </li>
                @if (Model.Descuento > 0)
                {
                    <li class="list-group-item d-flex justify-content-between text-success">
                        <span>🏷️ Descuento (@Model.CodigoCupon)</span>
                        <span id="descuento-resumen">- @Model.Descuento.ToString("C0", co)</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between fw-bold fs-5 list-group-item-dark">
                    <span>Total estimado</span>
                    <span id="total-resumen">@Model.TotalConDescuento.ToString("C0", co)</span>
                </li>
            </ul>
        </div>
        <div class="mt-3">
            <a class="btn btn-outline-secondary w-100" asp-controller="Carrito" asp-action="Index">
                ← Volver al carrito
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Muestra/oculta el campo de dirección según el tipo de entrega
        function toggleDireccion(valor) {
            const bloque = document.getElementById('bloque-direccion');
            bloque.style.display = (valor === 'true') ? 'block' : 'none';
        }

        // Inicializar estado según valor actual
        const rbDomicilio = document.getElementById('rb-domicilio');
        if (rbDomicilio && rbDomicilio.checked) {
            toggleDireccion('true');
        }

        // Resaltar campos vacíos al intentar enviar
        document.getElementById('form-confirmar').addEventListener('submit', function (e) {
            const nombre = document.getElementById('input-nombre');
            const tel    = document.getElementById('input-telefono');
            const esDOM  = document.getElementById('rb-domicilio').checked;
            const dir    = document.getElementById('input-direccion');

            let valido = true;

            [nombre, tel].forEach(function (campo) {
                if (!campo.value.trim()) {
                    campo.classList.add('is-invalid');
                    valido = false;
                } else {
                    campo.classList.remove('is-invalid');
                }
            });

            if (esDOM && !dir.value.trim()) {
                dir.classList.add('is-invalid');
                valido = false;
            } else {
                dir.classList.remove('is-invalid');
            }

            if (!valido) e.preventDefault();
        });
    </script>
}

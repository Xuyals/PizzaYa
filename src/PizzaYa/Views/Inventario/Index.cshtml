@model InventarioViewModel
@{
    ViewData["Title"] = "Inventario";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <div>
        <h1 class="fw-bold">Inventario</h1>
        <p class="text-muted mb-0">Revisa los ingredientes disponibles y pide a tus proveedores antes de que se acaben.</p>
    </div>
    <a class="btn btn-danger" asp-action="NuevoPedido">Nuevo pedido al proveedor</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (Model.PorAgotarse > 0)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2" role="status">
        <span>
            <strong>@Model.PorAgotarse</strong>
            @(Model.PorAgotarse == 1 ? "ingrediente está por agotarse." : "ingredientes están por agotarse.")
        </span>
        <a class="btn btn-sm btn-outline-dark" asp-action="NuevoPedido" asp-route-porAgotarse="true">Pedir los que están por agotarse</a>
    </div>
}

@* Escenarios 1 y 2: ver inventario / por agotarse *@
<h2 class="h4 mt-4">Ingredientes disponibles</h2>
@if (Model.Ingredientes.Count == 0)
{
    <div class="alert alert-secondary">No hay ingredientes registrados todavía.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Ingrediente</th>
                    <th class="text-end">Disponible</th>
                    <th class="text-end">Mínimo</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ing in Model.Ingredientes)
                {
                    <tr class="@(ing.PorAgotarse ? "table-danger" : "")">
                        <td class="@(ing.PorAgotarse ? "fw-semibold" : "")">@ing.Nombre</td>
                        <td class="text-end">@FormatoInventario.Cantidad(ing.Cantidad, ing.Unidad)</td>
                        <td class="text-end">@FormatoInventario.Cantidad(ing.CantidadMinima, ing.Unidad)</td>
                        <td>
                            @if (ing.PorAgotarse)
                            {
                                <span class="badge bg-danger">Por agotarse</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Suficiente</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (ing.PorAgotarse)
                            {
                                <a class="btn btn-sm btn-outline-danger" asp-action="NuevoPedido" asp-route-ingredienteId="@ing.Id">Pedir</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Escenarios 3 y 5: pedidos a proveedores y recibirlos *@
<h2 class="h4 mt-5">Pedidos a proveedores</h2>
@if (Model.Pedidos.Count == 0)
{
    <div class="alert alert-secondary">Aún no has hecho pedidos. Crea el primero con el botón de arriba.</div>
}
else
{
    foreach (var pedido in Model.Pedidos)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h3 class="h5 mb-0">@pedido.Proveedor</h3>
                        <small class="text-muted">
                            Creado @pedido.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            @if (pedido.RecibidoEn is not null)
                            {
                                <text> · Recibido @pedido.RecibidoEn.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</text>
                            }
                        </small>
                    </div>
                    @if (pedido.Estado == EstadoPedidoProveedor.Pendiente)
                    {
                        <span class="badge bg-warning text-dark">Pendiente</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Recibido</span>
                    }
                </div>

                <ul class="mt-3 mb-3">
                    @foreach (var item in pedido.Items)
                    {
                        <li>@FormatoInventario.Cantidad(item.Cantidad, item.Unidad) de @item.IngredienteNombre</li>
                    }
                </ul>

                @if (pedido.Estado == EstadoPedidoProveedor.Pendiente)
                {
                    <form asp-action="Recibir" asp-route-id="@pedido.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-success">Marcar como recibido</button>
                    </form>
                }
            </div>
        </div>
    }
}

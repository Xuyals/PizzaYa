@model NuevoPedidoViewModel
@{
    ViewData["Title"] = "Nuevo pedido al proveedor";

    bool Invalido(string clave) =>
        ViewData.ModelState.TryGetValue(clave, out var entrada) && entrada.Errors.Count > 0;

    var proveedorInvalido = Invalido("Pedido.Proveedor");
}

<a asp-action="Index" class="text-decoration-none">&larr; Volver al inventario</a>

<div class="mt-2 mb-4">
    <h1 class="fw-bold">Nuevo pedido al proveedor</h1>
    <p class="text-muted mb-0">Escribe el proveedor y la cantidad de cada ingrediente que quieres pedir. Deja en blanco los que no necesitas.</p>
</div>

<form asp-action="NuevoPedido" method="post" novalidate>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <strong>No se guardó el pedido.</strong> Revisa lo siguiente:
            <ul class="mb-0">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="mb-4">
        <label for="proveedor" class="form-label fw-semibold">Proveedor <span class="text-danger">*</span></label>
        <input type="text" id="proveedor" name="Pedido.Proveedor" maxlength="80"
               class="form-control @(proveedorInvalido ? "is-invalid" : "")"
               value="@Model.Pedido.Proveedor" placeholder="Ej: Distribuidora La Sabana" />
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Ingrediente</th>
                    <th class="text-end">Disponible</th>
                    <th style="width: 190px;">Cantidad a pedir</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Pedido.Lineas.Count; i++)
                {
                    var linea = Model.Pedido.Lineas[i];
                    var ing = Model.Ingredientes.FirstOrDefault(x => x.Id == linea.IngredienteId);
                    if (ing is null) { continue; }

                    var claveCantidad = $"Pedido.Lineas[{i}].Cantidad";
                    var cantidadInvalida = Invalido(claveCantidad);
                    var valor = linea.Cantidad?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

                    <tr class="@(ing.PorAgotarse ? "table-danger" : "")">
                        <td>
                            @ing.Nombre
                            @if (ing.PorAgotarse)
                            {
                                <span class="badge bg-danger ms-1">Por agotarse</span>
                            }
                            <input type="hidden" name="Pedido.Lineas[@i].IngredienteId" value="@ing.Id" />
                        </td>
                        <td class="text-end">@FormatoInventario.Cantidad(ing.Cantidad, ing.Unidad)</td>
                        <td>
                            <div class="input-group">
                                <input type="number" min="0" step="any" inputmode="decimal"
                                       name="Pedido.Lineas[@i].Cantidad" value="@valor"
                                       class="form-control text-end @(cantidadInvalida ? "is-invalid" : "")"
                                       aria-label="Cantidad de @ing.Nombre" />
                                <span class="input-group-text">@ing.Unidad</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-danger">Guardar pedido</button>
    </div>
</form>

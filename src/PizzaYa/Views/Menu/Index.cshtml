@model MenuViewModel
@{
    ViewData["Title"] = "Menú";
}

<div class="mb-4">
    <h1 class="fw-bold">Nuestro menú</h1>
    <p class="text-muted mb-0">Escoge una pizza y ármala a tu gusto.</p>
</div>

@if (TempData["Error"] is string aviso)
{
    <div class="alert alert-warning" role="alert">@aviso</div>
}

@if (!Model.HayPizzas)
{
    <div class="alert alert-warning text-center py-5" role="status">
        <div class="display-4 mb-2">🍕</div>
        <h2 class="h4">Pronto habrá pizzas</h2>
        <p class="mb-0">Estamos preparando el menú. Vuelve en un rato.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var pizza in Model.Pizzas)
        {
            <div class="col">
                <div class="card h-100 pizza-card">
                    @if (string.IsNullOrEmpty(pizza.ImagenUrl))
                    {
                        <div class="card-img-top pizza-img d-flex align-items-center justify-content-center" aria-hidden="true">🍕</div>
                    }
                    else
                    {
                        <img src="@pizza.ImagenUrl" class="card-img-top pizza-img" alt="Pizza @pizza.Nombre" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h2 class="card-title h5">@pizza.Nombre</h2>
                        @if (!string.IsNullOrEmpty(pizza.Descripcion))
                        {
                            <p class="card-text text-muted small">@pizza.Descripcion</p>
                        }
                        <p class="card-text small mb-3">
                            <strong>Ingredientes:</strong>
                            @string.Join(", ", pizza.IngredientesBase.Select(i => i.Nombre))
                        </p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="fs-5 fw-bold">@Formato.Pesos(pizza.PrecioBase)</span>
                            @if (Model.PizzasSinStock.Contains(pizza.Id))
                            {
                                <span class="badge text-bg-secondary me-2" data-sin-stock="@pizza.Id">No disponible</span>
                                <button type="button" class="btn btn-secondary" disabled>Personalizar</button>
                            }
                            else
                            {
                                <a class="btn btn-danger" asp-action="Personalizar" asp-route-id="@pizza.Id">Personalizar</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

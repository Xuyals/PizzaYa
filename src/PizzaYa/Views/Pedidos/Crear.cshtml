@model PizzaYa.Models.Pedido

@{
    ViewData["Title"] = "Crear Pedido";
}

<div class="container mt-4">
    <h2>Realizar Pedido</h2>
    <hr />
    <form asp-action="Crear" method="post">
        <div class="mb-3">
            <label asp-for="ClienteNombre" class="form-label">Nombre del Cliente</label>
            <input asp-for="ClienteNombre" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="ClienteTelefono" class="form-label">Teléfono</label>
            <input asp-for="ClienteTelefono" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="DireccionEntrega" class="form-label">Dirección de Entrega</label>
            <input asp-for="DireccionEntrega" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Total" class="form-label">Total a Pagar ($)</label>
            <input asp-for="Total" type="number" step="0.01" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-success">Confirmar Pedido</button>
    </form>
</div>
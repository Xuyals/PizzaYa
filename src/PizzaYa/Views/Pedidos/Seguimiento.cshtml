@model PizzaYa.Models.Pedido

@{
    ViewData["Title"] = "Seguimiento de Pedido";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3>Seguimiento del Pedido #@Model.Id</h3>
        </div>
        <div class="card-body">
            <p><strong>Cliente:</strong> @Model.ClienteNombre</p>
            <p><strong>Dirección:</strong> @Model.DireccionEntrega</p>
            <p><strong>Fecha:</strong> @Model.FechaCreacion</p>
            <hr />
            <h4>Estado Actual: <span class="badge bg-warning text-dark">@Model.Estado</span></h4>
            <p class="text-muted">Tu pedido está siendo procesado por nuestro equipo.</p>
            
            <a href="/Pedidos/Crear" class="btn btn-secondary mt-3">Hacer otro pedido</a>
        </div>
    </div>
</div>
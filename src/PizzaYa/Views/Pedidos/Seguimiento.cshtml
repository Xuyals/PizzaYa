@model PizzaYa.Models.Pedido
@{
    ViewData["Title"] = "Seguimiento del pedido";
}

<div class="card shadow-sm">
    <div class="card-header fw-bold">Pedido @Model.NumeroPedido</div>
    <div class="card-body">
        <p><strong>Cliente:</strong> @Model.NombreCliente</p>
        <p class="mb-0"><strong>Estado actual:</strong> <span class="badge bg-warning text-dark">@Model.Estado</span></p>
    </div>
</div>

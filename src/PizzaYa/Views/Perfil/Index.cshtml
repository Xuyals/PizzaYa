@model PizzaYa.Models.PerfilViewModel
@{
    ViewData["Title"] = "Mi perfil";
    var co = new System.Globalization.CultureInfo("es-CO");
}

<h1 class="h3 fw-bold mb-3">Mi perfil</h1>
<p class="text-muted">Hola, @Model.Nombre.</p>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success" role="alert">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert" id="error-perfil">@error</div>
}

@if (Model.SinDatos)
{
    <div class="alert alert-info" id="perfil-sin-datos">
        Aún no tienes pizzas favoritas ni pedidos. Arma tu primera pizza en el <a asp-controller="Menu" asp-action="Index">menú</a>.
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        @* ── Pizzas favoritas ── *@
        <div class="card shadow-sm mb-4" id="seccion-favoritas">
            <div class="card-header fw-bold">⭐ Mis pizzas favoritas</div>
            @if (Model.Favoritas.Count == 0)
            {
                <div class="card-body text-muted">Todavía no tienes pizzas favoritas. Marca una desde el resumen de tu pizza.</div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var f in Model.Favoritas)
                    {
                        <li class="list-group-item" data-favorita="@f.Favorita.Id">
                            <div class="d-flex justify-content-between flex-wrap gap-2">
                                <div>
                                    <div class="fw-semibold">@f.NombrePizza — @f.NombreTamano</div>
                                    <small class="text-muted">
                                        Borde @f.NombreBorde
                                        @if (f.Extras.Count > 0) { <text> · Extras: @string.Join(", ", f.Extras)</text> }
                                        @if (f.Quitados.Count > 0) { <text> · Sin: @string.Join(", ", f.Quitados)</text> }
                                    </small>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold">@f.Precio.ToString("C0", co)</div>
                                    <form asp-action="PedirFavorita" asp-route-id="@f.Favorita.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger">Pedir de nuevo</button>
                                    </form>
                                    <form asp-action="EliminarFavorita" asp-route-id="@f.Favorita.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Quitar de favoritas">✕</button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

        @* ── Último pedido ── *@
        <div class="card shadow-sm" id="seccion-ultimo-pedido">
            <div class="card-header fw-bold">🧾 Mi último pedido</div>
            @if (Model.UltimoPedido is null)
            {
                <div class="card-body text-muted">Todavía no has hecho pedidos.</div>
            }
            else
            {
                var p = Model.UltimoPedido;
                <div class="card-body">
                    <div class="d-flex justify-content-between flex-wrap">
                        <span class="fw-bold font-monospace">@p.NumeroPedido</span>
                        <span class="text-muted small">@p.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <p class="mb-2">Estado: <span class="badge bg-warning text-dark">@p.Estado</span></p>
                    <ul class="mb-2">
                        @foreach (var item in p.Items)
                        {
                            <li>@item.Cantidad × @item.NombrePizza (@item.NombreTamano, borde @item.NombreBorde)</li>
                        }
                    </ul>
                    <p class="fw-bold">Total: @p.Total.ToString("C0", co)</p>
                    <div class="d-flex gap-2">
                        <form asp-action="RepetirUltimo" method="post">
                            <button type="submit" class="btn btn-danger btn-sm">Repetir este pedido</button>
                        </form>
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Pedidos" asp-action="Seguimiento" asp-route-numero="@p.NumeroPedido">Ver seguimiento</a>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ── Mis cupones ── *@
    <div class="col-lg-5">
        <div class="card shadow-sm" id="seccion-cupones">
            <div class="card-header fw-bold">🏷️ Mis cupones</div>
            @if (Model.Cupones.Count == 0)
            {
                <div class="card-body text-muted">No tienes cupones vigentes por ahora.</div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var c in Model.Cupones)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center" data-cupon="@c.Codigo">
                            <div>
                                <div class="fw-bold font-monospace">@c.Codigo</div>
                                <small class="text-muted">
                                    @c.Descripcion
                                    @if (c.VenceEn is { } vence) { <text> · vence el @vence.ToLocalTime().ToString("dd/MM/yyyy")</text> }
                                </small>
                            </div>
                            <form asp-action="AplicarCupon" method="post">
                                <input type="hidden" name="codigo" value="@c.Codigo" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Usar en mi pedido</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            <div class="card-footer">
                <form asp-action="AplicarCupon" method="post" class="d-flex gap-2">
                    <input type="text" name="codigo" class="form-control form-control-sm" placeholder="¿Tienes otro cupón? Escríbelo" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">Aplicar</button>
                </form>
            </div>
        </div>
    </div>
</div>
